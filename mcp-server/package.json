{
  "name": "favourite-recipes-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that lets an agent add/edit recipes by committing to the favourite-recipes repo",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "npm ci --prefix ../shared --omit=dev --no-audit --no-fund",
    "typecheck": "tsc -p .",
    "test": "tsc -p . && node --test test/*.test.{js,ts}",
    "dev": "node scripts/dev.ts"
  },
  "dependencies": {
    "@langfuse/client": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/context-async-hooks": "~2.11.0",
    "@opentelemetry/core": "~2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.222.0",
    "@opentelemetry/otlp-exporter-base": "~0.222.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-trace-base": "~2.11.0",
    "@vercel/functions": "^3.11.0",
    "gray-matter": "^4.0.3",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
