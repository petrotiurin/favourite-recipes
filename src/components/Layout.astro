---
// Every page's shell: head, the page-context JSON for the chat (docs/chatbot-design.md 7.2), the footer and the chat widget's script.
// Pages are written to HTML by the build; the scripts only add to them. Links stay relative to the page (`rootPrefix` is the way back to the root).
import { pageContextSchema, type PageContext } from "../../shared/page-context.ts";
import { authConfig, chatConfig } from "../lib/env.ts";
import { scriptJson } from "../lib/json.ts";
import { reloadOnStaleScript } from "../lib/reload-guard.ts";
// The one stylesheet: Astro bundles it with a hashed name, and each page links the file it was built with (docs/typescript-migration.md 4.11).
import "../../styles/style.css";

interface Props {
  title: string;
  bodyClass?: string;
  rootPrefix?: string;
  /** Which page this is (and which recipe), so the chat can resolve "this recipe". Data only, baked in at build time. */
  pageContext: PageContext;
}
const { title, bodyClass, rootPrefix = "", pageContext } = Astro.props;

const context = scriptJson(pageContextSchema.parse(pageContext));
// Sign-in (src/lib/auth.ts): the build's public Supabase values in `#auth-config`, and the boot script (src/lib/auth-boot.ts), in the head so it runs
// before the chat's script (which still finds sign-in through window.RecipeAuth until step 8).
const auth = authConfig();
// The chat widget (docs/chatbot-design.md): no bubble and no script without CHAT_API_URL.
const chat = chatConfig();
// Reloads once when an island's script is gone after a deploy (src/lib/reload-guard.ts), written into the page as it is.
const reloadGuard = `(${reloadOnStaleScript.toString()})(window)`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {/* First in the head: a script after a stylesheet waits for it (the fonts), and this one has to be there before any island wakes up. */}
  <script is:inline set:html={reloadGuard}></script>
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23ad4a1d'/%3E%3Ccircle cx='16' cy='16' r='7' fill='none' stroke='%23fff' stroke-width='2.5'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Public+Sans:wght@400;500;600&display=swap">
  {auth && <script is:inline type="application/json" id="auth-config" data-supabase-url={auth.supabaseUrl} data-supabase-key={auth.supabaseKey}></script>}
  {auth && <script>import "../lib/auth-boot.ts";</script>}
</head>
<body class={bodyClass || undefined}>
  <slot />
  <script is:inline type="application/json" id="page-context" set:html={context}></script>
  <footer class="site-footer">Our Favourite Recipes</footer>
  {chat && <script is:inline src={`${rootPrefix}chat.js`} data-api={chat.api} data-public={chat.publicOff ? "false" : undefined} defer></script>}
</body>
</html>
