{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../shared",
  "installCommand": "npm ci && npm ci --prefix ../shared --omit=dev",
  "functions": {
    "api/*.js": { "maxDuration": 300, "includeFiles": "{workflows/**,../shared/**}" }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/upload", "destination": "/api/upload" },
    { "source": "/stocktake", "destination": "/api/stocktake" },
    { "source": "/chat", "destination": "/api/chat" },
    { "source": "/chat/:route*", "destination": "/api/chat?route=:route*" }
  ]
}
