---
// The 1/2/4-servings selector's markup (the recipe's own number too). Hidden until servings.js runs; servings.js opens the page at the
// pressed option: 4 servings, like the shopping page.
import { DEFAULT_SERVINGS } from "../../shared/shopping-list.ts";

interface Props {
  serves: number;
}
const { serves } = Astro.props;
const options = [...new Set([1, 2, 4, serves])].sort((a, b) => a - b);
---
<div class="servings-picker" data-base={serves} hidden>
  <span class="servings-label" id="servings-label">Serves</span>
  <div class="seg" role="group" aria-labelledby="servings-label">
    {options.map((n) => <button type="button" data-serves={n} aria-pressed={n === DEFAULT_SERVINGS ? "true" : "false"}>{n}</button>)}
  </div>
</div>
