---
// One recipe tile (the home page and the Next week page). `kicker` is the small-caps line: its text and an optional class; `cls` adds classes to the tile.
import Photo from "./Photo.astro";
import type { RecipeFrontmatter } from "../../shared/recipe.ts";

interface Props {
  recipe: Pick<RecipeFrontmatter, "slug" | "title" | "image" | "total_mins" | "calories">;
  kicker: { label: string; cls?: string };
  cls?: string;
}
const { recipe, kicker, cls } = Astro.props;
---
<a class:list={["tile", cls]} href={`recipes/${recipe.slug}.html`}>
  <Photo class="tile-image" image={recipe.image} slug={recipe.slug} kind="tile" loading="lazy" />
  <p class:list={["kicker", kicker.cls]}>{kicker.label}</p>
  <h2 class="tile-title">{recipe.title}</h2>
  <p class="tile-meta">{recipe.total_mins} min &middot; {recipe.calories} kcal</p>
</a>
